# Copy this file to .env and edit. .env is git-ignored, so your real values are never uploaded.
ADMIN_EMAIL=admin@foodloop.local
ADMIN_PASSWORD=choose-your-own-admin-password
# SECRET_KEY signs login tokens. Leave unset locally (one is generated and kept in backend/.local_secrets.json).
# SECRET_KEY=
# Optional: real road distances from a routing service. Empty = straight-line x 1.3 fallback.
# OSRM_URL=https://router.project-osrm.org
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
